{
	"name": "actions",
	"version": "0.0.1",
	"description": "GitHub Actions for Vercel deployments",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Oliver Stenbom <oliver@endform.dev>",
	"homepage": "https://github.com/endformdev/actions#readme",
	"bugs": {
		"url": "https://github.com/endformdev/actions/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/endformdev/actions"
	},
	"keywords": [
		"github-actions",
		"vercel",
		"playwright",
		"endform"
	],
	"scripts": {
		"build": "pnpm --filter './run-with-vercel-deployment' build",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write"
	},
	"packageManager": "pnpm@12.11.2",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^26.6.5",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@actions/core": "^3.0.1"
	}
}
